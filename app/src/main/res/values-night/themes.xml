<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HODOS_FINAL_ANDROID" parent="Theme.Material3.DayNight">
        <item name="android:statusBarColor">@android:color/white</item>
        <!-- Nếu muốn icon trên status bar tối (để nhìn rõ trên nền trắng): -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.MyApp" parent="Theme.Material3.DayNight">
        <!-- Customize for Dark Mode -->
        <item name="colorPrimary">#BB86FC</item>
        <item name="colorPrimaryVariant">#3700B3</item>
        <item name="colorOnPrimary">#000000</item>
    </style>
    <!-- Base application theme. -->


    <style name="Theme.MyApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/home_banner</item>
        <item name="postSplashScreenTheme">@style/Theme.HODOS_FINAL_ANDROID</item>
    </style>

</resources>